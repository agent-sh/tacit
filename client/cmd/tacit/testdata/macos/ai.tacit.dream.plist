	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>19</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/someone/Library/Logs/tacit/dream.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/someone/Library/Logs/tacit/dream.log</string>
