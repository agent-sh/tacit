#!/bin/bash
# tacit pre-receive: one run per push, stdin "<old> <new> <ref>" lines.
# Enforces the SPEC.md write rules while objects are still quarantined:
#   - only refs/heads/main may change; no deletes (git config also denies them)
#   - a writer may touch only inbox/<writer>/...; curator@* may touch anything
#   - writers may not push merge commits, symlinks or submodules
#   - no new blob may contain an obvious secret
# The net tree diff old..new is checked (not per commit), so a merge cannot
# smuggle changes. Any error fails closed: non-zero exit rejects the push and
# nothing persists.
set -euo pipefail

writer="${TACIT_WRITER:-}"
[ -n "$writer" ] || { echo "tacit: no writer identity" >&2; exit 1; }
zero=0000000000000000000000000000000000000000
empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
case "$writer" in
  curator@*) curator=1 ;;
  *) curator=0; scope="inbox/$writer/" ;;
esac

fail() { echo "tacit: $*" >&2; exit 1; }
difffile=$(mktemp "${TMPDIR:-/tmp}/tacit-diff.XXXXXX")
blobfile=$(mktemp "${TMPDIR:-/tmp}/tacit-blob.XXXXXX")
tokenfile=$(mktemp "${TMPDIR:-/tmp}/tacit-tokens.XXXXXX")
trap 'rm -f "$difffile" "$blobfile" "$tokenfile"' EXIT
# Token shapes, Slack webhook URLs and private-key headers (secret_re), and
# three families of keys that take two steps, since a fact name can start
# like one: a token is the family's prefix and a run of key characters
# (<family>_token_re), and a token is a key when that run holds what a real
# key has (<family>_key_re).
# A fact name is lowercase letters, digits and hyphens, so
# lint-cc-sk-017-only-plain-commands, tskey-auth-expires-in-90-days and
# slack-xoxb-token-scopes are no keys.
#   sk-: 16 key characters ([A-Za-z0-9_-]); a key holds an uppercase letter
#     or underscore, a run of 20 letters and digits, or a lowercase UUID
#     (Anthropic sk-ant-..., OpenAI sk-proj-... and the legacy 48 characters,
#     OpenRouter, Langfuse, LiteLLM).
#   slack: xoxa-, xoxb-, xoxc-, xoxd-, xoxe-, xoxo-, xoxp-, xoxr-, xoxs- or
#     xapp- and 10 key characters ([A-Za-z0-9-]); a key holds an uppercase
#     letter, a run of 20 letters and digits, a run of 10 digits or two runs
#     of 6 joined by a hyphen (team, user and app ids), or is a legacy
#     workspace token's xoxa-<digit>- or xoxr-<digit>-.
#   tskey: tskey- and 10 key characters; a key holds an uppercase letter (its
#     id ends in CNTRL) or a run of 20 letters and digits.
# Measured: eval/secrets/token_rules.py. client/internal/secretscan holds the
# same expressions; its test keeps them equal to these lines.
secret_re='(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|(^|[^A-Za-z0-9])hf_[A-Za-z0-9]{20,}|hooks\.slack\.com/(services|workflows|triggers)/[A-Za-z0-9+/]{43,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
sk_token_re='(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{16,}'
sk_key_re='sk-[A-Za-z0-9_-]*([A-Z_]|[A-Za-z0-9]{20}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})'
slack_token_re='(xox[abcdeoprs]|xapp)-[A-Za-z0-9-]{10,}'
slack_key_re='(xox[abcdeoprs]|xapp)-[A-Za-z0-9-]*([A-Z]|[A-Za-z0-9]{20}|[0-9]{10}|[0-9]{6}-[0-9]{6})|xox[ar]-[0-9]-'
tskey_token_re='tskey-[A-Za-z0-9-]{10,}'
tskey_key_re='tskey-[A-Za-z0-9-]*([A-Z]|[A-Za-z0-9]{20})'
# Every family's token starts with one of these: a blob without any of them
# skips the six family steps (a hook run greps each blob of a push).
family_prefix_re='sk-|xox[abcdeoprs]-|xapp-|tskey-'

# scan RE FILE [-o]: 0 when FILE holds RE (with -o, the matches go to
# $tokenfile), 1 when it does not. Bytes, not characters (LC_ALL=C, -a): the
# shapes are ASCII, a byte that is not valid UTF-8 or a NUL must not hide a
# key, and only in the C locale does GNU grep match these bracket ranges in
# linear time (under the server's C.UTF-8 a 27 KB line of sk- runs took 15 s,
# with the old rule too). Any other status (a bad expression, a read error, a
# token file that cannot be opened or written) refuses the push: `if grep`
# would read it as no match, and so would a redirection that fails.
scan() {
  local rc=0
  if [ "${3:-}" = -o ]; then
    ( exec >"$tokenfile" || exit 2; LC_ALL=C exec grep -aEo -- "$1" "$2" ) || rc=$?
  else
    LC_ALL=C grep -aEq -- "$1" "$2" || rc=$?
  fi
  [ "$rc" -le 1 ] || fail "the secret scan of $path failed (grep exit $rc)"
  return "$rc"
}

while read -r old new ref; do
  [ "$ref" = "refs/heads/main" ] || fail "only refs/heads/main may be pushed (got $ref)"
  [ "$new" != "$zero" ] || fail "deleting main is not allowed"
  base="$old"
  [ "$old" != "$zero" ] || base="$empty_tree"

  if [ "$curator" = 0 ]; then
    merges=$(git rev-list --min-parents=2 "$new" --not "$old" 2>/dev/null | head -1 || true)
    [ -z "$merges" ] || fail "$writer may not push merge commits (rebase instead)"
  fi

  # Net change between base and new: ":<old mode> <new mode> <old sha> <new sha> <status>\t<path>[\t<path2>]"
  git -c core.quotePath=false diff-tree -r --raw --no-renames "$base" "$new" > "$difffile"
  while IFS=$'\t' read -r meta path; do
    [ -n "$meta" ] || continue
    set -- $meta
    new_mode="$2"; new_sha="$4"; status="${5:0:1}"
    if [ "$curator" = 0 ]; then
      case "$path" in
        "$scope"*) ;;
        *) fail "$writer may write only under $scope (tried $path)" ;;
      esac
      [ "$status" != "D" ] || fail "$writer may not delete $path (supersede, never delete)"
      case "$new_mode" in
        100644|100755) ;;
        *) fail "$writer may not add $path with mode $new_mode (symlinks and submodules are not facts)" ;;
      esac
    fi
    case "$path" in
      *..*) fail "path $path contains .." ;;
    esac
    if [ "$status" != "D" ]; then
      # Through a file, not a pipe: under pipefail, `grep -q` matching early
      # kills `git cat-file` with SIGPIPE (141), the pipeline reads as "no
      # match", and a secret near the top of a blob over the pipe buffer got in.
      # A failing cat-file stops the hook here (set -e): fail closed.
      git cat-file -p "$new_sha" > "$blobfile"
      if scan "$secret_re" "$blobfile"; then
        fail "$path looks like it contains a secret"
      fi
      if scan "$family_prefix_re" "$blobfile"; then
        for family in sk slack tskey; do
          token_re="${family}_token_re" key_re="${family}_key_re"
          if scan "${!token_re}" "$blobfile" -o && scan "${!key_re}" "$tokenfile"; then
            fail "$path looks like it contains a secret"
          fi
        done
      fi
    fi
  done < "$difffile"
done
# Accepted pushes are not logged here: the server journals every ref move
# (state.db, `GET /journal`) and logs `push by <writer>` to systemd's journal,
# so a hook-side log file would only duplicate them and grow without bound.
exit 0
