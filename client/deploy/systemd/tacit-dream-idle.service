[Unit]
Description=tacit idle dreamer: quiet or compacted sessions to inbox facts, then a quick curate

[Service]
EnvironmentFile=%h/.config/tacit/env
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=%h/.local/bin/tacit dream --idle 20m
ExecStart=%h/.local/bin/tacit curate --quick --min-interval 30m
